{
  "routes": [
    {
      "routePath": "/api/openai",
      "mountPath": "/api",
      "method": "OPTIONS",
      "module": [
        "api/openai.ts:onRequestOptions"
      ]
    },
    {
      "routePath": "/api/openai",
      "mountPath": "/api",
      "method": "POST",
      "module": [
        "api/openai.ts:onRequestPost"
      ]
    },
    {
      "routePath": "/api/send-otp",
      "mountPath": "/api",
      "method": "OPTIONS",
      "module": [
        "api/send-otp.ts:onRequestOptions"
      ]
    },
    {
      "routePath": "/api/send-otp",
      "mountPath": "/api",
      "method": "POST",
      "module": [
        "api/send-otp.ts:onRequestPost"
      ]
    }
  ],
  "baseURL": "/"
}